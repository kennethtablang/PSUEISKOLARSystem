{
  // Local development reaches the API under whatever host the machine happens to answer
  // on — localhost, a LAN IP from a phone, an ngrok subdomain. Production narrows this.
  "AllowedHosts": "*",
  // Links in emails (verify email, reset password) open the React app, which the Vite dev
  // server hosts on this port during development — not the API's own port.
  "EmailSettings": {
    "AppBaseUrl": "https://localhost:56806"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
