{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  /* Host header filtering. "*" accepts any Host, which lets a request forged with someone
     else's hostname be reflected back into absolute URLs (password-reset links among them).
     Add the deployment's real hostname here before going live; appsettings.Development.json
     relaxes this back to "*" so LAN and tunnelled testing still work locally. */
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  /* MultipleActiveResultSets is off on purpose. With it on, SqlClient's async path stalls under
     concurrent requests (dotnet/SqlClient#422): the dashboard and the notification list, which
     every page load requests together, each took 20-27 seconds while SQL Server sat idle.
     Nothing here needs MARS: every query is buffered (ToListAsync), none are streamed. Keep it
     off in the production connection string too (see DEPLOYMENT.md). */
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=PSUEISKOLARSystem;Trusted_Connection=True;MultipleActiveResultSets=false;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "PSUEISKOLARSystem",
    "Audience": "PSUEISKOLARSystem.Client",
    "ExpiryMinutes": 60
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "From": "noreply.eiskolar.psulingayen@gmail.com",
    "FromName": "EIskolarSystem",
